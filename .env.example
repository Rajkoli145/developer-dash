# Workspace owner — created automatically on first launch
OWNER_EMAIL=owner@localhost
OWNER_NAME=

# PostgreSQL connection string (Neon / Supabase / Vercel Postgres / local)
# Example: postgresql://user:password@host/db?sslmode=require
DATABASE_URL=

# Where uploaded document files are stored.
# Local dev: "uploads" (project folder). On Vercel leave unset — /tmp is used.
UPLOAD_DIR=uploads
